@model SistemaMecanica.Models.Mecanico
@{
    ViewData["Title"] = "Novo Mecânico";
}

<h2>Novo Mecânico</h2>
<hr />

<form asp-action="Create" method="post">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <div class="mb-3">
        <label asp-for="NomeCompleto" class="form-label">Nome Completo</label>
        <input asp-for="NomeCompleto" class="form-control" />
        <span asp-validation-for="NomeCompleto" class="text-danger"></span>
    </div>

    <div class="row">
        <div class="col-md-6 mb-3">
            <label asp-for="CPF" class="form-label">CPF</label>
            <input asp-for="CPF" class="form-control" />
            <span asp-validation-for="CPF" class="text-danger"></span>
        </div>
        <div class="col-md-3 mb-3">
            <label asp-for="TipoSanguineo" class="form-label">Tipo Sanguíneo</label>
            <select asp-for="TipoSanguineo" class="form-select">
                <option value="">Selecione...</option>
                <option value="A+">A+</option>
                <option value="A-">A-</option>
                <option value="B+">B+</option>
                <option value="B-">B-</option>
                <option value="AB+">AB+</option>
                <option value="AB-">AB-</option>
                <option value="O+">O+</option>
                <option value="O-">O-</option>
            </select>
            <span asp-validation-for="TipoSanguineo" class="text-danger"></span>
        </div>
    </div>

    <div class="row">
        <div class="col-md-6 mb-3">
            <label asp-for="TelefonePessoal" class="form-label">Telefone Pessoal</label>
            <input asp-for="TelefonePessoal" class="form-control" />
            <span asp-validation-for="TelefonePessoal" class="text-danger"></span>
        </div>
        <div class="col-md-6 mb-3">
            <label asp-for="TelefoneResponsavel" class="form-label">Telefone Responsável</label>
            <input asp-for="TelefoneResponsavel" class="form-control" />
            <span asp-validation-for="TelefoneResponsavel" class="text-danger"></span>
        </div>
    </div>

    <div class="mb-3">
        <label asp-for="Email" class="form-label">E-mail</label>
        <input asp-for="Email" class="form-control" />
        <span asp-validation-for="Email" class="text-danger"></span>
    </div>

    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-success">Cadastrar</button>
        <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
    </div>
</form>