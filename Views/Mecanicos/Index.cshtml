@model IEnumerable<SistemaMecanica.Models.Mecanico>
@{
    ViewData["Title"] = "Mecânicos";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Mecânicos</h2>
    <a asp-action="Create" class="btn btn-primary">+ Novo Mecânico</a>
</div>

<table class="table table-striped table-hover">
    <thead class="table-dark">
        <tr>
            <th>Código</th>
            <th>Nome</th>
            <th>CPF</th>
            <th>Telefone</th>
            <th>Ações</th>
        </tr>
    </thead>
    <tbody>
        @foreach (Mecanico mecanico in Model)
        {
            <tr>
                <td>@mecanico.Id</td>
                <td>@mecanico.NomeCompleto</td>
                <td>@mecanico.CPF</td>
                <td>@mecanico.TelefonePessoal</td>
                <td>
                    <a asp-action="Details" asp-route-id="@mecanico.Id" class="btn btn-sm btn-info">Detalhes</a>
                    <a asp-action="Edit" asp-route-id="@mecanico.Id" class="btn btn-sm btn-warning">Editar</a>
                    <a asp-action="Delete" asp-route-id="@mecanico.Id" class="btn btn-sm btn-danger">Excluir</a>
                </td>
            </tr>
        }
    </tbody>
</table>