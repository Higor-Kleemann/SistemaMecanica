@model SistemaMecanica.Models.Mecanico
@{
    ViewData["Title"] = "Detalhes do Mecânico";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Detalhes do Mecânico</h2>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Editar</a>
        <a asp-action="Index" class="btn btn-secondary">Voltar</a>
    </div>
</div>
<hr />

<dl class="row">
    <dt class="col-sm-3">Código</dt>
    <dd class="col-sm-9">@Model.Id</dd>

    <dt class="col-sm-3">Nome Completo</dt>
    <dd class="col-sm-9">@Model.NomeCompleto</dd>

    <dt class="col-sm-3">CPF</dt>
    <dd class="col-sm-9">@Model.CPF</dd>

    <dt class="col-sm-3">Tipo Sanguíneo</dt>
    <dd class="col-sm-9">@Model.TipoSanguineo</dd>

    <dt class="col-sm-3">Telefone Pessoal</dt>
    <dd class="col-sm-9">@Model.TelefonePessoal</dd>

    <dt class="col-sm-3">Telefone Responsável</dt>
    <dd class="col-sm-9">@Model.TelefoneResponsavel</dd>

    <dt class="col-sm-3">E-mail</dt>
    <dd class="col-sm-9">@Model.Email</dd>
</dl>