@model IEnumerable<SistemaMecanica.Models.Cliente>

@{
    ViewData["Title"] = "Clientes";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Clientes</h2>
    <a asp-action="Create" class="btn btn-primary">+ Novo Cliente</a>
</div>

<form asp-action="Index" method="get" class="row g-3 mb-4">
    <div class="col-md-4">
        <input type="text" name="busca" class="form-control" placeholder="Buscar por nome, CPF ou CNPJ..." value="@ViewBag.Busca" />
    </div>
    <div class="col-md-auto">
        <button type="submit" class="btn btn-primary me-2">Buscar</button>
        <a asp-action="Index" class="btn btn-secondary">Limpar</a>
    </div>
</form>

<table class="table table-striped table-hover">
    <thead class="table-dark">
        <tr>
            <th>Código</th>
            <th>Nome</th>
            <th>Tipo</th>
            <th>Documento</th>
            <th>Telefone</th>
            <th>Ações</th>
        </tr>
    </thead>
    <tbody>
        @foreach (Cliente cliente in Model)
        {
            <tr>
                <td>@cliente.Id</td>
                <td>@cliente.NomeCompleto</td>
                <td>@cliente.TipoPessoa</td>
                <td>@(cliente.TipoPessoa == "PF" ? cliente.CPF : cliente.CNPJ)</td>
                <td>@cliente.Telefone</td>
                <td>
                    <a asp-action="Details" asp-route-id="@cliente.Id" class="btn btn-sm btn-info">Detalhes</a>
                    <a asp-action="Edit" asp-route-id="@cliente.Id" class="btn btn-sm btn-warning">Editar</a>
                    <a asp-action="Delete" asp-route-id="@cliente.Id" class="btn btn-sm btn-danger">Excluir</a>
                </td>
            </tr>
        }
    </tbody>
</table>