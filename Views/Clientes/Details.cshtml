@model SistemaMecanica.Models.Cliente

@{
    ViewData["Title"] = "Detalhes do Cliente";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Detalhes do Cliente</h2>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Editar</a>
        <a asp-action="Index" class="btn btn-secondary">Voltar</a>
    </div>
</div>

<hr />

<dl class="row">
    <dt class="col-sm-3">Código</dt>
    <dd class="col-sm-9">@Model.Id</dd>

    <dt class="col-sm-3">Tipo</dt>
    <dd class="col-sm-9">@(Model.TipoPessoa == "PF" ? "Pessoa Física" : "Pessoa Jurídica")</dd>

    <dt class="col-sm-3">@(Model.TipoPessoa == "PF" ? "Nome Completo" : "Razão Social")</dt>
    <dd class="col-sm-9">@Model.NomeCompleto</dd>

    @if (Model.TipoPessoa == "PF")
    {
        <dt class="col-sm-3">CPF</dt>
        <dd class="col-sm-9">@Model.CPF</dd>
    }
    else
    {
        <dt class="col-sm-3">CNPJ</dt>
        <dd class="col-sm-9">@Model.CNPJ</dd>

        <dt class="col-sm-3">Nome Fantasia</dt>
        <dd class="col-sm-9">@Model.NomeFantasia</dd>
    }

    <dt class="col-sm-3">Endereço</dt>
    <dd class="col-sm-9">@Model.Rua, @Model.Numero — @Model.Bairro, @Model.Cidade — CEP: @Model.CEP</dd>

    <dt class="col-sm-3">E-mail</dt>
    <dd class="col-sm-9">@Model.Email</dd>

    <dt class="col-sm-3">Telefone</dt>
    <dd class="col-sm-9">@Model.Telefone</dd>
</dl>

<hr />

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4>Veículos Cadastrados</h4>
    <a asp-controller="Veiculos" asp-action="Create" asp-route-clienteId="@Model.Id" class="btn btn-primary btn-sm">+ Novo Veículo</a>
</div>

@if (Model.Veiculos != null && Model.Veiculos.Any())
{
    <table class="table table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th>Placa</th>
                <th>Marca</th>
                <th>Ano/Modelo</th>
                <th>KM</th>
                <th>Cor</th>
                <th>Ações</th>
            </tr>
        </thead>
        <tbody>
            @foreach (Veiculo veiculo in Model.Veiculos)
            {
                <tr>
                    <td>@veiculo.Placa</td>
                    <td>@veiculo.Marca</td>
                    <td>@veiculo.AnoModelo</td>
                    <td>@veiculo.KM</td>
                    <td>@veiculo.Cor</td>
                    <td>
                        <a asp-controller="Veiculos" asp-action="Edit" asp-route-id="@veiculo.Id" class="btn btn-sm btn-warning">Editar</a>
                        <a asp-controller="Veiculos" asp-action="Delete" asp-route-id="@veiculo.Id" class="btn btn-sm btn-danger">Excluir</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <div class="alert alert-info">Nenhum veículo cadastrado para este cliente.</div>
}
