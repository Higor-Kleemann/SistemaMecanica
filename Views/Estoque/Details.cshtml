@model SistemaMecanica.Models.Estoque
@{
    ViewData["Title"] = "Detalhes do Estoque";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Detalhes do Estoque</h2>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Editar</a>
        <a asp-action="Index" class="btn btn-secondary">Voltar</a>
    </div>
</div>
<hr />

<dl class="row">
    <dt class="col-sm-3">Código</dt>
    <dd class="col-sm-9">@Model.Id</dd>

    <dt class="col-sm-3">Produto</dt>
    <dd class="col-sm-9">@Model.Produto?.Nome</dd>

    <dt class="col-sm-3">Quantidade</dt>
    <dd class="col-sm-9">@Model.Quantidade</dd>

    <dt class="col-sm-3">Prateleira</dt>
    <dd class="col-sm-9">@Model.CodigoPrateleira</dd>

    <dt class="col-sm-3">Nível</dt>
    <dd class="col-sm-9">@Model.CodigoNivel</dd>
</dl>