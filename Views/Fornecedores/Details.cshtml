@model SistemaMecanica.Models.Fornecedor
@{
    ViewData["Title"] = "Detalhes do Fornecedor";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Detalhes do Fornecedor</h2>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Editar</a>
        <a asp-action="Index" class="btn btn-secondary">Voltar</a>
    </div>
</div>
<hr />

<dl class="row">
    <dt class="col-sm-3">Código</dt>
    <dd class="col-sm-9">@Model.Id</dd>

    <dt class="col-sm-3">Nome Fantasia</dt>
    <dd class="col-sm-9">@Model.NomeFantasia</dd>

    <dt class="col-sm-3">CNPJ</dt>
    <dd class="col-sm-9">@Model.CNPJ</dd>

    <dt class="col-sm-3">Endereço</dt>
    <dd class="col-sm-9">@Model.Rua, @Model.Numero — @Model.Bairro, @Model.Cidade — CEP: @Model.CEP</dd>

    <dt class="col-sm-3">E-mail</dt>
    <dd class="col-sm-9">@Model.Email</dd>

    <dt class="col-sm-3">Telefone</dt>
    <dd class="col-sm-9">@Model.Telefone</dd>
</dl>

<div class="d-flex gap-2 mt-3">
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Editar</a>
    <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger">Excluir</a>
    <a asp-action="Index" class="btn btn-secondary">Voltar</a>
</div>