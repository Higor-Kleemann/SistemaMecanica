@model IEnumerable<SistemaMecanica.Models.Fornecedor>
@{
    ViewData["Title"] = "Fornecedores";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Fornecedores</h2>
    <a asp-action="Create" class="btn btn-primary">+ Novo Fornecedor</a>
</div>

<form asp-action="Index" method="get" class="row g-3 mb-4">
    <div class="col-md-4">
        <input type="text" name="busca" class="form-control" placeholder="Buscar por CNPJ..." value="@ViewBag.Busca" />
    </div>
    <div class="col-md-auto">
        <button type="submit" class="btn btn-primary me-2">Buscar</button>
        <a asp-action="Index" class="btn btn-secondary">Limpar</a>
    </div>
</form>

<table class="table table-striped table-hover">
    <thead class="table-dark">
        <tr>
            <th>Código</th>
            <th>Nome Fantasia</th>
            <th>CNPJ</th>
            <th>Telefone</th>
            <th>Cidade</th>
            <th>Ações</th>
        </tr>
    </thead>
    <tbody>
        @foreach (Fornecedor fornecedor in Model)
        {
            <tr>
                <td>@fornecedor.Id</td>
                <td>@fornecedor.NomeFantasia</td>
                <td>@fornecedor.CNPJ</td>
                <td>@fornecedor.Telefone</td>
                <td>@fornecedor.Cidade</td>
                <td>
                    <a asp-action="Details" asp-route-id="@fornecedor.Id" class="btn btn-sm btn-info">Detalhes</a>
                    <a asp-action="Edit" asp-route-id="@fornecedor.Id" class="btn btn-sm btn-warning">Editar</a>
                    <a asp-action="Delete" asp-route-id="@fornecedor.Id" class="btn btn-sm btn-danger">Excluir</a>
                </td>
            </tr>
        }
    </tbody>
</table>