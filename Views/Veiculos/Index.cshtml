@model IEnumerable<SistemaMecanica.Models.Veiculo>
@{
    ViewData["Title"] = "Veiculo";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Veículos</h2>
    <a asp-action="Create" class="btn btn-primary">+ Novo Veículo</a>
</div>

<table class="table table-striped table-hover">
    <thead class="table-dark">
        <tr>
            <th>Placa</th>
            <th>Marca</th>
            <th>Ano/Modelo</th>
            <th>KM</th>
            <th>Cor</th>
            <th>Cliente</th>
            <th>Ações</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var veiculo in Model)
        {
            <tr>
                <td style="text-transform: uppercase;">@veiculo.Placa</td>
                <td>@veiculo.Marca</td>
                <td>@veiculo.AnoModelo</td>
                <td>@veiculo.KM km</td>
                <td>@veiculo.Cor</td>
                <td>@veiculo.Cliente?.NomeCompleto</td>
                <td>
                    <a asp-action="Details" asp-route-id="@veiculo.Id" class="btn btn-sm btn-info">Detalhes</a>
                    <a asp-action="Edit" asp-route-id="@veiculo.Id" class="btn btn-sm btn-warning">Editar</a>
                    <a asp-action="Delete" asp-route-id="@veiculo.Id" class="btn btn-sm btn-danger">Excluir</a>
                </td>
            </tr>
        }
    </tbody>
</table>