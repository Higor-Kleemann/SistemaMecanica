@model SistemaMecanica.Models.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<h2 class="mb-4">Dashboard</h2>

<div class="row mb-4">
    <div class="col-md-3">
        <div class="card text-white bg-warning">
            <div class="card-body">
                <h6 class="card-title">Abertas</h6>
                <p class="card-text fs-3 fw-bold">@Model.OsAbertas</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-white bg-primary">
            <div class="card-body">
                <h6 class="card-title">Em Andamento</h6>
                <p class="card-text fs-3 fw-bold">@Model.OsEmAndamento</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-white bg-success">
            <div class="card-body">
                <h6 class="card-title">Concluídas</h6>
                <p class="card-text fs-3 fw-bold">@Model.OsConcluidas</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-white bg-info">
            <div class="card-body">
                <h6 class="card-title">Entregues</h6>
                <p class="card-text fs-3 fw-bold">@Model.OsEntregues</p>
            </div>
        </div>
    </div>
</div>

<div class="row mb-4">
    <div class="col-md-4">
        <div class="card">
            <div class="card-body">
                <h6 class="card-title text-muted">Faturamento do Mês</h6>
                <p class="card-text fs-3 fw-bold text-success">R$ @Model.FaturamentoMesAtual.ToString("F2")</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card">
            <div class="card-body">
                <h6 class="card-title text-muted">Clientes Cadastrados</h6>
                <p class="card-text fs-3 fw-bold">@Model.TotalClientes</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card">
            <div class="card-body">
                <h6 class="card-title text-muted">Veículos Cadastrados</h6>
                <p class="card-text fs-3 fw-bold">@Model.TotalVeiculos</p>
            </div>
        </div>
    </div>
</div>

<h4>⚠ Produtos com Estoque Baixo</h4>
@if (Model.ProdutosEstoqueBaixo.Any())
{
    <table class="table table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th>Produto</th>
                <th>Quantidade</th>
                <th>Prateleira</th>
                <th>Nível</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var estoque in Model.ProdutosEstoqueBaixo)
            {
                <tr>
                    <td>@estoque.Produto?.Nome</td>
                    <td>
                        <span class="badge @(estoque.Quantidade == 0 ? "bg-danger" : "bg-warning")">
                            @estoque.Quantidade
                        </span>
                    </td>
                    <td>@estoque.CodigoPrateleira</td>
                    <td>@estoque.CodigoNivel</td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <div class="alert alert-success">Nenhum produto com estoque baixo no momento.</div>
}