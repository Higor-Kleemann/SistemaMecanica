@model SistemaMecanica.Models.Produto
@{
    ViewData["Title"] = "Novo Produto";
}

<h2>Novo Produto</h2>
<hr />

<form asp-action="Create" method="post">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <div class="mb-3">
        <label asp-for="Nome" class="form-label">Nome</label>
        <input asp-for="Nome" class="form-control" />
        <span asp-validation-for="Nome" class="text-danger"></span>
    </div>

    <div class="row">
        <div class="col-md-6 mb-3">
            <label asp-for="CategoriaId" class="form-label">Categoria</label>
            <select asp-for="CategoriaId" class="form-select"
                    asp-items="@(new SelectList(ViewBag.Categorias, "Id", "Nome"))">
                <option value="">Selecione a categoria...</option>
            </select>
            <span asp-validation-for="CategoriaId" class="text-danger"></span>
        </div>
        <div class="col-md-6 mb-3">
            <label asp-for="UnidadeMedidaId" class="form-label">Unidade de Medida</label>
            <select asp-for="UnidadeMedidaId" class="form-select"
                    asp-items="@(new SelectList(ViewBag.UnidadesMedida, "Id", "Nome"))">
                <option value="">Selecione a unidade...</option>
            </select>
            <span asp-validation-for="UnidadeMedidaId" class="text-danger"></span>
        </div>
    </div>

    <div class="mb-3">
        <label asp-for="Preco" class="form-label">Preço</label>
        <div class="input-group">
            <span class="input-group-text">R$</span>
            <input asp-for="Preco" class="form-control" type="number" step="0.01" />
        </div>
        <span asp-validation-for="Preco" class="text-danger"></span>
    </div>

    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-success">Cadastrar</button>
        <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
    </div>
</form>