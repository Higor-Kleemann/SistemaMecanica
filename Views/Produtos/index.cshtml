@model IEnumerable<SistemaMecanica.Models.Produto>
@{
    ViewData["Title"] = "Produtos";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Produtos</h2>
    <a asp-action="Create" class="btn btn-primary">+ Novo Produto</a>
</div>

<form asp-action="Index" method="get" class="row g-3 mb-4">
    <div class="col-md-4">
        <input type="text" name="busca" class="form-control" placeholder="Buscar por nome do produto..." value="@ViewBag.Busca" />
    </div>
    <div class="col-md-auto">
        <button type="submit" class="btn btn-primary me-2">Buscar</button>
        <a asp-action="Index" class="btn btn-secondary">Limpar</a>
    </div>
</form>

<table class="table table-striped table-hover">
    <thead class="table-dark">
        <tr>
            <th>Código</th>
            <th>Nome</th>
            <th>Categoria</th>
            <th>Unidade</th>
            <th>Preço</th>
            <th>Ações</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var produto in Model)
        {
            <tr>
                <td>@produto.Id</td>
                <td>@produto.Nome</td>
                <td>@produto.Categoria?.Nome</td>
                <td>@produto.UnidadeMedida?.Nome</td>
                <td>R$ @produto.Preco.ToString("F2")</td>
                <td>
                    <a asp-action="Details" asp-route-id="@produto.Id" class="btn btn-sm btn-info">Detalhes</a>
                    <a asp-action="Edit" asp-route-id="@produto.Id" class="btn btn-sm btn-warning">Editar</a>
                    <a asp-action="Delete" asp-route-id="@produto.Id" class="btn btn-sm btn-danger">Excluir</a>
                </td>
            </tr>
        }
    </tbody>
</table>