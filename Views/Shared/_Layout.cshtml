<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SistemaMecanica</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/SistemaMecanica.styles.css" asp-append-version="true" />
</head>
<body>
    @{
        var controllerAtual = ViewContext.RouteData.Values["controller"]?.ToString();
    }

    <button class="sidebar-toggle d-md-none" type="button" aria-label="Abrir menu">
        <span class="navbar-toggler-icon"></span>
    </button>

    <div class="app-wrapper">
        <nav class="sidebar">
            <div class="sidebar-brand">
                <a asp-area="" asp-controller="Home" asp-action="Index">SistemaMecanica</a>
            </div>

            <div class="sidebar-group">
                <span class="sidebar-group-title">Cadastros</span>
                <a class="sidebar-link @(controllerAtual == "Clientes" ? "active" : "")" asp-controller="Clientes" asp-action="Index">Clientes</a>
                <a class="sidebar-link @(controllerAtual == "Veiculos" ? "active" : "")" asp-controller="Veiculos" asp-action="Index">Veículos</a>
                <a class="sidebar-link @(controllerAtual == "Fornecedores" ? "active" : "")" asp-controller="Fornecedores" asp-action="Index">Fornecedores</a>
                <a class="sidebar-link @(controllerAtual == "Mecanicos" ? "active" : "")" asp-controller="Mecanicos" asp-action="Index">Mecânicos</a>
            </div>

            <div class="sidebar-group">
                <span class="sidebar-group-title">Catálogo</span>
                <a class="sidebar-link @(controllerAtual == "Produtos" ? "active" : "")" asp-controller="Produtos" asp-action="Index">Produtos</a>
                <a class="sidebar-link @(controllerAtual == "Servicos" ? "active" : "")" asp-controller="Servicos" asp-action="Index">Serviços</a>
                <a class="sidebar-link @(controllerAtual == "Estoque" ? "active" : "")" asp-controller="Estoque" asp-action="Index">Estoque</a>
                <a class="sidebar-link @(controllerAtual == "Categorias" ? "active" : "")" asp-controller="Categorias" asp-action="Index">Categorias</a>
                <a class="sidebar-link @(controllerAtual == "UnidadesMedida" ? "active" : "")" asp-controller="UnidadesMedida" asp-action="Index">Unidades de Medida</a>
            </div>

            <div class="sidebar-group">
                <span class="sidebar-group-title">Operação</span>
                <a class="sidebar-link @(controllerAtual == "OrdemServico" ? "active" : "")" asp-controller="OrdemServico" asp-action="Index">Ordem de Serviço</a>
                <a class="sidebar-link @(controllerAtual == "Caixa" ? "active" : "")" asp-controller="Caixa" asp-action="Index">Caixa</a>
            </div>
        </nav>

        <div class="main-content">
            <main role="main" class="container pb-3 pt-3">
                @RenderBody()
            </main>

            <footer class="border-top footer text-muted">
                <div class="container">
                    &copy; 2026 - SistemaMecanica - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
                </div>
            </footer>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/layout/sidebar.js" asp-append-version="true" defer></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>