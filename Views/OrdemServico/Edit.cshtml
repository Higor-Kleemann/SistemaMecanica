@model SistemaMecanica.Models.OrdemServico
@{
    ViewData["Title"] = "Editar Ordem de Serviço";
}

<h2>Editar Ordem de Serviço</h2>
<hr />

<form asp-action="Edit" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Status" />
    <input type="hidden" asp-for="DataEntrada" />
    <input type="hidden" asp-for="ValorTotal" />
    <input type="hidden" asp-for="Id" />
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <div class="row">
        <div class="col-md-4 mb-3">
            <label asp-for="ClienteId" class="form-label">Cliente</label>
            <select asp-for="ClienteId" class="form-select"
                    asp-items="@(new SelectList(ViewBag.Clientes, "Id", "NomeCompleto"))">
                <option value="">Selecione o cliente...</option>
            </select>
            <span asp-validation-for="ClienteId" class="text-danger"></span>
        </div>
        <div class="col-md-4 mb-3">
            <label asp-for="VeiculoId" class="form-label">Veículo</label>
            <select asp-for="VeiculoId" class="form-select"
                    asp-items="@(new SelectList(ViewBag.Veiculos, "Id", "Placa"))">
                <option value="">Selecione o veículo...</option>
            </select>
            <span asp-validation-for="VeiculoId" class="text-danger"></span>
        </div>
        <div class="col-md-4 mb-3">
            <label asp-for="MecanicoId" class="form-label">Mecânico</label>
            <select asp-for="MecanicoId" class="form-select"
                    asp-items="@(new SelectList(ViewBag.Mecanicos, "Id", "NomeCompleto"))">
                <option value="">Selecione o mecânico...</option>
            </select>
            <span asp-validation-for="MecanicoId" class="text-danger"></span>
        </div>
    </div>

    <div class="mb-3">
        <div class="mb-3">
            <label asp-for="Observacao" class="form-label">Observação</label>
            <textarea asp-for="Observacao" class="form-control" rows="4" placeholder="Descreva o serviço a ser realizado..."></textarea>
        </div>
    </div>

    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-warning">Salvar Alterações</button>
        <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
    </div>
</form>