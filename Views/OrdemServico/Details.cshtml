@model SistemaMecanica.Models.OrdemServico
@{
    ViewData["Title"] = "Detalhes da OS";
}

<div class="d-flex gap-2">
    @if (Model.Status != "Concluído" && Model.Status != "Entregue")
    {
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Editar</a>
    }
    <a asp-action="Index" class="btn btn-secondary">Voltar</a>
</div>

<hr />

<div class="row mb-4">
    <div class="col-md-6">
        <dl class="row">
            <dt class="col-sm-4">Cliente</dt>
            <dd class="col-sm-8">@Model.Cliente?.NomeCompleto</dd>

            <dt class="col-sm-4">Veículo</dt>
            <dd class="col-sm-8">@Model.Veiculo?.Placa — @Model.Veiculo?.Marca @Model.Veiculo?.AnoModelo</dd>

            <dt class="col-sm-4">Mecânico</dt>
            <dd class="col-sm-8">@Model.Mecanico?.NomeCompleto</dd>
        </dl>
    </div>
    <div class="col-md-6">
        <dl class="row">
            <dt class="col-sm-4">Data Entrada</dt>
            <dd class="col-sm-8">@Model.DataEntrada.ToString("dd/MM/yyyy HH:mm")</dd>

            <dt class="col-sm-4">Data Saída</dt>
            <dd class="col-sm-8">@(Model.DataSaida.HasValue ? Model.DataSaida.Value.ToString("dd/MM/yyyy HH:mm") : "Em aberto")</dd>

            <dt class="col-sm-4">Status</dt>
            <dd class="col-sm-8">
                <span class="badge @(Model.Status == "Aberto" ? "bg-warning" :
                     Model.Status == "Em andamento" ? "bg-primary" :
                     Model.Status == "Concluído" ? "bg-success" :
                     Model.Status == "Entregue" ? "bg-info" : "bg-secondary")">
                    @Model.Status
                </span>
            </dd>
            <dt class="col-sm-4">Valor Total</dt>
            <dd class="col-sm-8">R$ @Model.ValorTotal.ToString("F2")</dd>
        </dl>
    </div>
</div>

<hr>
<div>
    <h4>Observações</h4>
    <p>@Model.Observacao</p>
</div>
<hr />

<h4>Itens da Ordem de Serviço</h4>

@if (Model.Status != "Concluído" && Model.Status != "Entregue")
{
    <form asp-controller="ItemOS" asp-action="Adicionar" method="post" class="row g-3 mt-2 mb-2">
        @Html.AntiForgeryToken()
        <input type="hidden" name="OrdemServicoId" value="@Model.Id" />
        <div class="col-md-5">
            <select name="ProdutoId" class="form-select">
                <option value="">Selecione o produto...</option>
                @foreach (var produto in ViewBag.Produtos)
                {
                    <option value="@produto.Id">@produto.Nome — R$ @produto.Preco.ToString("F2")</option>
                }
            </select>
        </div>
        <div class="col-md-3">
            <input name="Quantidade" type="number" class="form-control" placeholder="Quantidade" min="1" value="1" />
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-success w-100">+ Produto</button>
        </div>
    </form>

    <form asp-controller="ItemOS" asp-action="AdicionarServico" method="post" class="row g-3 mt-2 mb-4">
        @Html.AntiForgeryToken()
        <input type="hidden" name="OrdemServicoId" value="@Model.Id" />
        <div class="col-md-4">
            <select name="ServicoId" class="form-select" id="selectServico">
                <option value="">Selecione o serviço...</option>
                @foreach (var servico in ViewBag.Servicos)
                {
                    <option value="@servico.Id"
                            data-preco="@servico.Preco?.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)">
                        @servico.Nome @(servico.Preco.HasValue ? $"— R$ {servico.Preco.Value.ToString("F2")}" : "— Valor variável")
                    </option>
                }
            </select>
        </div>
        <div class="col-md-3">
            <div class="input-group">
                <span class="input-group-text">R$</span>
                <input name="precoUnitario" type="number" step="0.01" class="form-control" id="precoServico" placeholder="Valor" />
            </div>
        </div>
        <div class="col-md-3">
            <input name="descricao" type="text" class="form-control" placeholder="Descrição (opcional)" />
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-primary w-100">+ Serviço</button>
        </div>
    </form>
}
else
{
    <div class="alert alert-warning mt-2 mb-4">
        Esta OS está finalizada e não permite mais alterações nos itens.
    </div>
}

@if (Model.Itens != null && Model.Itens.Any())
{
    <table class="table table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th>Produto</th>
                <th>Quantidade</th>
                <th>Preço Unitário</th>
                <th>Subtotal</th>
                @if (Model.Status != "Concluído" && Model.Status != "Entregue") {
                    <th>Ações</th>
                }
                
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Itens)
            {
                <tr>
                    <td>
                        @if (item.Produto != null)
                        {
                            <span class="badge bg-secondary me-1">Produto</span>
                            @item.Produto.Nome
                        }
                        else if (item.Servico != null)
                        {
                            <span class="badge bg-primary me-1">Serviço</span>
                            @item.Servico.Nome
                            @if (!string.IsNullOrEmpty(item.Descricao))
                            {
                                <small class="text-muted d-block">@item.Descricao</small>
                            }
                        }
                    </td>
                    <td>@item.Quantidade</td>
                    <td>R$ @item.PrecoUnitario.ToString("F2")</td>
                    <td>R$ @((item.Quantidade * item.PrecoUnitario).ToString("F2"))</td>
                    @if (Model.Status != "Concluído" && Model.Status != "Entregue")
                    {
                        <td>
                            <form asp-controller="ItemOS" asp-action="Remover" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@item.Id" />
                                <input type="hidden" name="ordemServicoId" value="@Model.Id" />
                                <button type="submit" class="btn btn-sm btn-danger">Remover</button>
                            </form>
                        </td>
                    }
                </tr>
            }
        </tbody>
        <tfoot>
            <tr class="table-dark">
                @if (Model.Status != "Concluído" && Model.Status != "Entregue")
                {
                    <td colspan="3" class="text-end fw-bold">Valor Total:</td>
                    <td colspan="2" class="fw-bold">R$ @Model.ValorTotal.ToString("F2")</td>
                }
                else
                {
                    <td colspan="3" class="text-end fw-bold">Valor Total:</td>
                    <td colspan="1" class="fw-bold">R$ @Model.ValorTotal.ToString("F2")</td>
                }
            </tr>
        </tfoot>
    </table>
}
else
{
    <div class="alert alert-info">Nenhum item adicionado a esta OS.</div>
}

<hr />

@if (TempData["Erro"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show mt-2" role="alert">
        <strong>⚠ Atenção:</strong> @TempData["Erro"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<h4>Atualizar Status</h4>
<div class="d-flex gap-2 mt-3">

    @if (Model.Status == "Aberto" || Model.Status == "Em andamento")
    {
        <form asp-action="AtualizarStatus" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@Model.Id" />
            <input type="hidden" name="status" value="Concluído" />
            <button type="submit" class="btn btn-success">
                ✔ Marcar como Concluído
            </button>
        </form>
    }

    @if (Model.Status == "Concluído")
    {
        <form asp-action="AtualizarStatus" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@Model.Id" />
            <input type="hidden" name="status" value="Entregue" />
            <button type="submit" class="btn btn-primary">
                🚗 Marcar como Entregue
            </button>
        </form>
    }

    @if (Model.Status == "Entregue" || Model.Status == "Concluído")
    {
        <span class="badge bg-success fs-6 p-2">
            ✔ OS Finalizada — Caixa atualizado automaticamente
        </span>
    }
</div>

@section Scripts {
    <script src="~/js/ordemservico/details.js" defer></script>
}