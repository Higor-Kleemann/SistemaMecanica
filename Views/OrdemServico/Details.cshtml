@model SistemaMecanica.Models.OrdemServico
@{
    ViewData["Title"] = "Detalhes da OS";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Ordem de Serviço #@Model.Id</h2>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Editar</a>
        <a asp-action="Index" class="btn btn-secondary">Voltar</a>
    </div>
</div>
<hr />

<div class="row mb-4">
    <div class="col-md-6">
        <dl class="row">
            <dt class="col-sm-4">Cliente</dt>
            <dd class="col-sm-8">@Model.Cliente?.NomeCompleto</dd>

            <dt class="col-sm-4">Veículo</dt>
            <dd class="col-sm-8">@Model.Veiculo?.Placa — @Model.Veiculo?.Marca @Model.Veiculo?.AnoModelo</dd>

            <dt class="col-sm-4">Mecânico</dt>
            <dd class="col-sm-8">@Model.Mecanico?.NomeCompleto</dd>
        </dl>
    </div>
    <div class="col-md-6">
        <dl class="row">
            <dt class="col-sm-4">Data Entrada</dt>
            <dd class="col-sm-8">@Model.DataEntrada.ToString("dd/MM/yyyy HH:mm")</dd>

            <dt class="col-sm-4">Data Saída</dt>
            <dd class="col-sm-8">@(Model.DataSaida.HasValue ? Model.DataSaida.Value.ToString("dd/MM/yyyy HH:mm") : "Em aberto")</dd>

            <dt class="col-sm-4">Status</dt>
            <dd class="col-sm-8">
                <span class="badge @(Model.Status == "Aberto" ? "bg-warning" :
                                     Model.Status == "Em andamento" ? "bg-primary" :
                                     Model.Status == "Concluído" ? "bg-success" : "bg-secondary")">
                    @Model.Status
                </span>
            </dd>

            <dt class="col-sm-4">Observação</dt>
            <dd class="col-sm-8">@Model.Observacao</dd>

            <dt class="col-sm-4">Valor Total</dt>
            <dd class="col-sm-8">R$ @Model.ValorTotal.ToString("F2")</dd>
        </dl>
    </div>
</div>

<hr />
<h4>Itens da Ordem de Serviço</h4>

<form asp-controller="ItemOS" asp-action="Adicionar" method="post" class="row g-3 mt-2 mb-4">
    @Html.AntiForgeryToken()
    <input type="hidden" name="OrdemServicoId" value="@Model.Id" />

    <div class="col-md-5">
        <select name="ProdutoId" class="form-select">
            <option value="">Selecione o produto...</option>
            @foreach (var produto in ViewBag.Produtos)
            {
                <option value="@produto.Id">@produto.Nome — R$ @produto.Preco.ToString("F2")</option>
            }
        </select>
    </div>

    <div class="col-md-3">
        <input name="Quantidade" type="number" class="form-control" placeholder="Quantidade" min="1" value="1" />
    </div>

    <div class="col-md-2">
        <button type="submit" class="btn btn-success w-100">+ Adicionar</button>
    </div>
</form>

@if (Model.Itens != null && Model.Itens.Any())
{
    <table class="table table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th>Produto</th>
                <th>Quantidade</th>
                <th>Preço Unitário</th>
                <th>Subtotal</th>
                <th>Ações</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Itens)
            {
                <tr>
                    <td>@item.Produto?.Nome</td>
                    <td>@item.Quantidade</td>
                    <td>R$ @item.PrecoUnitario.ToString("F2")</td>
                    <td>R$ @((item.Quantidade * item.PrecoUnitario).ToString("F2"))</td>
                    <td>
                        <form asp-controller="ItemOS" asp-action="Remover" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@item.Id" />
                            <input type="hidden" name="ordemServicoId" value="@Model.Id" />
                            <button type="submit" class="btn btn-sm btn-danger">Remover</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
        <tfoot>
            <tr class="table-dark">
                <td colspan="3" class="text-end fw-bold">Valor Total:</td>
                <td colspan="2" class="fw-bold">R$ @Model.ValorTotal.ToString("F2")</td>
            </tr>
        </tfoot>
    </table>
}
else
{
    <div class="alert alert-info">Nenhum item adicionado a esta OS.</div>
}

<hr />
<h4>Atualizar Status</h4>
<form asp-action="AtualizarStatus" method="post" class="d-flex gap-2 mt-3">
    @Html.AntiForgeryToken()
    <input type="hidden" name="id" value="@Model.Id" />
    <select name="status" class="form-select w-auto">
        <option value="Aberto">Aberto</option>
        <option value="Em andamento">Em andamento</option>
        <option value="Concluído">Concluído</option>
        <option value="Entregue">Entregue</option>
    </select>
    <button type="submit" class="btn btn-primary">Atualizar</button>
</form>