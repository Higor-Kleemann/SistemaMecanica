@model SistemaMecanica.Models.Caixa
@{
    ViewData["Title"] = "Excluir Registro";
}

<h2>Excluir Registro de Caixa</h2>
<hr />

<div class="alert alert-danger">
    Tem certeza que deseja excluir este registro?
</div>

<dl class="row">
    <dt class="col-sm-3">Código</dt>
    <dd class="col-sm-9">@Model.Id</dd>

    <dt class="col-sm-3">OS</dt>
    <dd class="col-sm-9">#@Model.OrdemServicoId</dd>

    <dt class="col-sm-3">Tipo</dt>
    <dd class="col-sm-9">@Model.Tipo</dd>

    <dt class="col-sm-3">Valor</dt>
    <dd class="col-sm-9">R$ @Model.Valor.ToString("F2")</dd>

    <dt class="col-sm-3">Data</dt>
    <dd class="col-sm-9">@Model.DataRegistro.ToString("dd/MM/yyyy HH:mm")</dd>
</dl>

<form asp-action="Delete" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />
    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-danger">Confirmar Exclusão</button>
        <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
    </div>
</form>