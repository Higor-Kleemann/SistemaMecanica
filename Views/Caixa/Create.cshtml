@model SistemaMecanica.Models.Caixa
@{
    ViewData["Title"] = "Novo Registro de Caixa";
}

<h2>Novo Registro de Caixa</h2>
<hr />

<form asp-action="Create" method="post">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <div class="mb-3">
        <label asp-for="OrdemServicoId" class="form-label">Ordem de Serviço <span class="text-muted">(opcional)</span></label>
        <select asp-for="OrdemServicoId" class="form-select"
                asp-items="@(new SelectList(ViewBag.OrdensServico, "Id", "Id"))">
            <option value="">Nenhuma OS vinculada</option>
        </select>
    </div>

    <div class="mb-3">
        <label asp-for="Tipo" class="form-label">Tipo</label>
        <select asp-for="Tipo" class="form-select">
            <option value="">Selecione...</option>
            <option value="Entrada">Entrada</option>
            <option value="Saida">Saída</option>
        </select>
        <span asp-validation-for="Tipo" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Valor" class="form-label">Valor</label>
        <div class="input-group">
            <span class="input-group-text">R$</span>
            <input asp-for="Valor" class="form-control" type="number" step="0.01" />
        </div>
        <span asp-validation-for="Valor" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Descricao" class="form-label">Descrição</label>
        <textarea asp-for="Descricao" class="form-control" rows="3"></textarea>
    </div>

    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-success">Registrar</button>
        <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
    </div>
</form>