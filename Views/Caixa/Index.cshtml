@model IEnumerable<SistemaMecanica.Models.Caixa>
@{
    ViewData["Title"] = "Caixa Financeiro";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Caixa Financeiro</h2>
    <a asp-action="Create" class="btn btn-primary">+ Novo Registro</a>
</div>

<form asp-action="Index" method="get" class="row g-3 mb-3 align-items-end">
    <div class="col-md-2">
        <label class="form-label">Tipo</label>
        <select name="tipo" class="form-select">
            <option value="">Todos</option>
            <option value="Entrada" selected="@(ViewBag.Tipo == "Entrada")">Entrada</option>
            <option value="Saida" selected="@(ViewBag.Tipo == "Saida")">Saída</option>
        </select>
    </div>
    <div class="col-md-3">
        <label class="form-label">Data Início</label>
        <input type="date" name="dataInicio" class="form-control" value="@ViewBag.DataInicio" />
    </div>
    <div class="col-md-3">
        <label class="form-label">Data Fim</label>
        <input type="date" name="dataFim" class="form-control" value="@ViewBag.DataFim" />
    </div>
    <div class="col-md-4">
        <button type="submit" class="btn btn-primary me-2">Filtrar</button>
        <a asp-action="Index" class="btn btn-secondary">Limpar</a>
    </div>
</form>

<div class="d-flex gap-2 mb-4">
    <a asp-action="Index" asp-route-periodo="semana"
       class="btn btn-sm @(ViewBag.PeriodoAtivo == "semana" ? "btn-dark" : "btn-outline-dark")">Última Semana</a>
    <a asp-action="Index" asp-route-periodo="mes"
       class="btn btn-sm @(ViewBag.PeriodoAtivo == "mes" ? "btn-dark" : "btn-outline-dark")">Último Mês</a>
    <a asp-action="Index" asp-route-periodo="ano"
       class="btn btn-sm @(ViewBag.PeriodoAtivo == "ano" ? "btn-dark" : "btn-outline-dark")">Último Ano</a>
</div>

<div class="row mb-4">

<div class="row mb-4">
    <div class="col-md-4">
        <div class="card border-success">
            <div class="card-body">
                <h6 class="card-title text-success">Total de Entradas</h6>
                <h4 class="text-success">R$ @Model.Where(c => c.Tipo == "Entrada").Sum(c => c.Valor).ToString("F2")</h4>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-danger">
            <div class="card-body">
                <h6 class="card-title text-danger">Total de Saídas</h6>
                <h4 class="text-danger">R$ @Model.Where(c => c.Tipo == "Saida").Sum(c => c.Valor).ToString("F2")</h4>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-primary">
            <div class="card-body">
                <h6 class="card-title text-primary">Saldo</h6>
                @{
                    var saldo = Model.Where(c => c.Tipo == "Entrada").Sum(c => c.Valor)
                              - Model.Where(c => c.Tipo == "Saida").Sum(c => c.Valor);
                }
                <h4 class="text-primary">R$ @saldo.ToString("F2")</h4>
            </div>
        </div>
    </div>
</div>

<table class="table table-striped table-hover">
    <thead class="table-dark">
        <tr>
            <th>Código</th>
            <th>OS</th>
            <th>Tipo</th>
            <th>Valor</th>
            <th>Data</th>
            <th>Descrição</th>
            <th>Ações</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var caixa in Model)
        {
            <tr>
                <td>@caixa.Id</td>
                <td>@(caixa.OrdemServicoId.HasValue ? $"#{caixa.OrdemServicoId}" : "Avulso")</td>
                <td>
                    <span class="badge @(caixa.Tipo == "Entrada" ? "bg-success" : "bg-danger")">
                        @caixa.Tipo
                    </span>
                </td>
                <td>R$ @caixa.Valor.ToString("F2")</td>
                <td>@caixa.DataRegistro.ToString("dd/MM/yyyy HH:mm")</td>
                <td>@caixa.Descricao</td>
                <td>
                    <a asp-action="Details" asp-route-id="@caixa.Id" class="btn btn-sm btn-info">Detalhes</a>
                    <a asp-action="Edit" asp-route-id="@caixa.Id" class="btn btn-sm btn-warning">Editar</a>
                    <a asp-action="Delete" asp-route-id="@caixa.Id" class="btn btn-sm btn-danger">Excluir</a>
                </td>
            </tr>
        }
    </tbody>
</table>