@model SistemaMecanica.Models.Caixa
@{
    ViewData["Title"] = "Detalhes do Registro";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Detalhes do Registro</h2>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Editar</a>
        <a asp-action="Index" class="btn btn-secondary">Voltar</a>
    </div>
</div>
<hr />

<dl class="row">
    <dt class="col-sm-3">Código</dt>
    <dd class="col-sm-9">@Model.Id</dd>

    <dt class="col-sm-3">Ordem de Serviço</dt>
    <dd class="col-sm-9">
        @(Model.OrdemServicoId.HasValue 
            ? $"#{Model.OrdemServicoId} — {Model.OrdemServico?.Cliente?.NomeCompleto}" 
            : "Registro avulso")
    </dd>

    <dt class="col-sm-3">Tipo</dt>
    <dd class="col-sm-9">
        <span class="badge @(Model.Tipo == "Entrada" ? "bg-success" : "bg-danger")">
            @Model.Tipo
        </span>
    </dd>

    <dt class="col-sm-3">Valor</dt>
    <dd class="col-sm-9">R$ @Model.Valor.ToString("F2")</dd>

    <dt class="col-sm-3">Data</dt>
    <dd class="col-sm-9">@Model.DataRegistro.ToString("dd/MM/yyyy HH:mm")</dd>

    <dt class="col-sm-3">Descrição</dt>
    <dd class="col-sm-9">@Model.Descricao</dd>
</dl>